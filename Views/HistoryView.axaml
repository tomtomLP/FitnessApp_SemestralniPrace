<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FitnessApp.ViewModels"
             xmlns:m="using:FitnessApp.Models"
             x:Class="FitnessApp.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <Grid>
        <!-- Hlavní obsah -->
        <Grid RowDefinitions="Auto, *" Margin="20">
            
            <!-- Hlavička -->
            <TextBlock Grid.Row="0" Text="Historie" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

            <!-- Seznam odjetých tréninků -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding HistorieTreninku}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:ZaznamTreninku">
                            <Border Background="#151C2C" CornerRadius="15" Padding="20" Margin="0,0,0,15">
                                <Grid ColumnDefinitions="*, Auto">
                                    
                                    <!-- Informace o tréninku -->
                                    <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nazev}" Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Datum, StringFormat='{}{0:dd. MM. yyyy}'}" Foreground="#A0AABF" FontSize="14"/>
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                                            <Border Background="#1E2A40" CornerRadius="5" Padding="8,4">
                                                <TextBlock Text="{Binding OdcviceneCviky.Count, StringFormat='{}{0} cviků'}" Foreground="#00E5FF" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Tlačítka (Editovat a Smazat) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                                        <!-- Tlačítko pro Editaci tréninku -->
                                        <Button Command="{ReflectionBinding DataContext.OtevritEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Background="Transparent" Cursor="Hand" Padding="8">
                                            <TextBlock Text="✏️" Foreground="#00E5FF" FontSize="22"/>
                                        </Button>

                                        <!-- Tlačítko pro smazání záznamu -->
                                        <Button Command="{ReflectionBinding DataContext.OtevritSmazatDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Background="Transparent" Cursor="Hand" Padding="8">
                                            <TextBlock Text="🗑️" Foreground="#F44336" FontSize="22"/>
                                        </Button>
                                    </StackPanel>
                                    
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        

        <!-- Dialogy -->
        <!-- Editace tréninku jako aktivního -->
        <Grid Background="#AA000000" IsVisible="{Binding IsEditDialogVisible}" ZIndex="10">
            <Border Background="#090E17" CornerRadius="15" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,30,10,30">
                <Grid RowDefinitions="Auto, *, Auto">
                    
                    <!-- Hlavička -->
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,15">
                        <TextBlock Text="Editovat trénink" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        
                        <TextBox Text="{Binding EditNazev}" Background="#151C2C" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="10" FontSize="18" TextAlignment="Center" MaxLength="50"/>
                        
                        <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                            <!-- Výběr data -->
                            <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,5,0">
                                <TextBlock Text="Datum" Foreground="#A0AABF" FontSize="12" HorizontalAlignment="Center"/>
                                <DatePicker SelectedDate="{Binding EditDatum}" Background="#151C2C" Foreground="White" BorderThickness="0" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            
                            <!-- Výběr celkového času -->
                            <StackPanel Grid.Column="1" Spacing="5" Margin="5,0,0,0">
                                <TextBlock Text="Čas (HH:MM:SS)" Foreground="#A0AABF" FontSize="12" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                    <NumericUpDown Value="{Binding EditHodiny}" Minimum="0" Maximum="23" FormatString="00" ShowButtonSpinner="False" Width="50" Background="#151C2C" Foreground="White" BorderThickness="0"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Foreground="White"/>
                                    <NumericUpDown Value="{Binding EditMinuty}" Minimum="0" Maximum="59" FormatString="00" ShowButtonSpinner="False" Width="50" Background="#151C2C" Foreground="White" BorderThickness="0"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Foreground="White"/>
                                    <NumericUpDown Value="{Binding EditSekundy}" Minimum="0" Maximum="59" FormatString="00" ShowButtonSpinner="False" Width="50" Background="#151C2C" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Výpis cviků s možností úprav -->
                    <ScrollViewer Grid.Row="1" Margin="0,0,0,15">
                        <StackPanel Spacing="20">
                            <ItemsControl ItemsSource="{Binding EditCviky}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkoutCvikWrapper">
                                        <Border Background="#151C2C" CornerRadius="15" Padding="15" Margin="0,0,0,20">
                                            <StackPanel Spacing="10">
                                                
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding CvikNazev}" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    
                                                    <Button Grid.Column="1" Command="{ReflectionBinding DataContext.OdebratCvikZTreninkuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" Cursor="Hand" Padding="8">
                                                        <TextBlock Text="✕" Foreground="#F44336" FontSize="18" FontWeight="Bold"/>
                                                    </Button>
                                                </Grid>

                                                <Grid ColumnDefinitions="45, *, *, 55, 40" Margin="0,10,0,5">
                                                    <TextBlock Grid.Column="0" Text="Série" Foreground="#A0AABF" FontSize="12" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="Kg" Foreground="#A0AABF" FontSize="12" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="Opak." Foreground="#A0AABF" FontSize="12" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="Hotovo" Foreground="#A0AABF" FontSize="12" HorizontalAlignment="Center"/>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Serie}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:WorkoutSerieWrapper">
                                                            <Grid ColumnDefinitions="45, *, *, 55, 40" Margin="0,5">
                                                                <Button Grid.Column="0" Command="{ReflectionBinding DataContext.PrepnoutWarmupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" Padding="0" HorizontalAlignment="Center" Cursor="Hand">
                                                                    <Panel Width="36" Height="36">
                                                                        <Border Background="#1E2A40" CornerRadius="8" IsVisible="{Binding !JeWarmup}">
                                                                            <TextBlock Text="{Binding Poradi}" Foreground="#A0AABF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <Border Background="#F44336" CornerRadius="8" Opacity="0.2" IsVisible="{Binding JeWarmup}"/>
                                                                        <TextBlock Text="🔥" IsVisible="{Binding JeWarmup}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                                                    </Panel>
                                                                </Button>

                                                                <NumericUpDown Grid.Column="1" Value="{Binding Vaha}" Minimum="0" Maximum="999" Background="#090E17" Foreground="White" BorderThickness="0" CornerRadius="8" ShowButtonSpinner="False" TextAlignment="Center" Margin="5,0"/>
                                                                <NumericUpDown Grid.Column="2" Value="{Binding Opakovani}" Minimum="0" Maximum="999" Background="#090E17" Foreground="White" BorderThickness="0" CornerRadius="8" ShowButtonSpinner="False" TextAlignment="Center" Margin="5,0"/>

                                                                <Button Grid.Column="3" Command="{ReflectionBinding DataContext.PrepnoutHotovoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" Padding="0" HorizontalAlignment="Center" Cursor="Hand">
                                                                    <Panel Width="44" Height="36">
                                                                        <Border Background="#1E2A40" CornerRadius="8" IsVisible="{Binding !JeHotovo}">
                                                                            <TextBlock Text="✔️" Foreground="#A0AABF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Opacity="0.5"/>
                                                                        </Border>
                                                                        <Border Background="#00E676" CornerRadius="8" IsVisible="{Binding JeHotovo}">
                                                                            <TextBlock Text="✔️" Foreground="#090E17" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                                                        </Border>
                                                                    </Panel>
                                                                </Button>

                                                                <Button Grid.Column="4" Command="{ReflectionBinding DataContext.OdebratSeriiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" Padding="0" HorizontalAlignment="Center" Cursor="Hand">
                                                                    <TextBlock Text="✕" Foreground="#A0AABF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Command="{Binding PridatSeriiCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" Padding="10" Cursor="Hand">
                                                    <TextBlock Text="+ Přidat sérii" Foreground="#00E5FF" FontWeight="Bold" FontSize="14"/>
                                                </Button>

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Tlačítko Přidat cvik v Editaci -->
                            <Button Command="{Binding OtevritPridatCvikDialogCommand}" Background="Transparent" HorizontalAlignment="Stretch" Padding="20" Cursor="Hand">
                                <Grid>
                                    <Rectangle Stroke="#2A364F" StrokeThickness="2" RadiusX="15" RadiusY="15" StrokeDashArray="4,4"/>
                                    <TextBlock Text="+ Přidat cvik" Foreground="#A0AABF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Padding="15"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Uložit / Zrušit -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, 10, *">
                        <Button Grid.Column="0" Content="Zrušit změny" Command="{Binding ZrusitEditaciCommand}" Background="Transparent" Foreground="#F44336" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand" Padding="15"/>
                        <Button Grid.Column="2" Content="Uložit trénink" Command="{Binding UlozitEditaciCommand}" Background="#00E5FF" Foreground="#090E17" FontWeight="Bold" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand" Padding="15"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Přidat cvik (v editaci) -->
        <Grid Background="#AA000000" IsVisible="{Binding IsAddExerciseDialogVisible}" ZIndex="20">
            <Border Background="#151C2C" CornerRadius="15" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" MaxHeight="600">
                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                    <TextBlock Grid.Row="0" Text="Přidat cvik" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <Border Grid.Row="1" Background="#090E17" CornerRadius="8" Margin="0,0,0,10" Padding="10,2">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="🔍" Foreground="#A0AABF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding HledanyText}" Background="Transparent" BorderThickness="0" Foreground="White" Watermark="Hledat cvik..." FontSize="14"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding KategorieList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{ReflectionBinding DataContext.ZmenKategoriiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Background="#090E17" CornerRadius="15" Padding="12,6" Cursor="Hand">
                                        <TextBlock Text="{Binding}" Foreground="#A0AABF" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="3" Background="#090E17" Padding="10" CornerRadius="8">
                        <ItemsControl ItemsSource="{Binding ZobrazeneCvikyKVyberu}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Cvik">
                                    <Button Command="{ReflectionBinding DataContext.VybratCvikCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Background="Transparent" HorizontalAlignment="Stretch" Cursor="Hand" Padding="5,10">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Nazev}" Foreground="White" VerticalAlignment="Center" FontSize="16" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="★" Foreground="#FFC107" IsVisible="{Binding JeOblibeny}" VerticalAlignment="Center" Margin="10,0,5,0" FontSize="18"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <Button Grid.Row="4" Content="Zavřít" Command="{Binding ZavritPridatCvikDialogCommand}" Background="#2A364F" Foreground="White" FontWeight="Bold" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Potvrzení Smazání záznamu -->
        <Grid Background="#AA000000" IsVisible="{Binding IsDeleteDialogVisible}" ZIndex="20">
            <Border Background="#151C2C" CornerRadius="15" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <StackPanel Spacing="15">
                    <TextBlock Text="Smazat záznam?" FontSize="18" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Center"/>
                    <TextBlock Text="Opravdu chcete smazat tento trénink z historie? Smažou se tím i nabrané statistiky." Foreground="White" TextWrapping="Wrap" FontSize="14" TextAlignment="Center"/>
                    
                    <Grid ColumnDefinitions="*, 10, *">
                        <Button Grid.Column="0" Content="Zrušit" Command="{Binding ZrusitSmazaniCommand}" Background="Transparent" Foreground="#A0AABF" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="Smazat" Command="{Binding PotvrditSmazaniCommand}" Background="#F44336" Foreground="White" FontWeight="Bold" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>